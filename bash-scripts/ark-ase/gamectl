#!/bin/bash
#############################################################
## Name          : gamectl
## Version       : 1.6.1
## Date          : 2026-07-31
## Maintainer    : OzarkMountainPirate - github.com/OzarkMountainPirate/utilities
## Credit        : Design inspired by LHammonds' ark-bash toolkit
##               : (github.com/LHammonds/ark-bash).
## Compatibility : Ubuntu Server 24.04 LTS (Debian 13 - Testing)  |  ARK: Survival Evolved (app 376030)
## Requirements  : steamcmd, rsync, mcrcon (RCON), systemd
## Purpose       : One tool to install, run, cluster, mod, back up, and update
##                 ARK: Survival Evolved dedicated server instances on Linux.
## Exit Codes    : 0 = success, 1 = usage/arg error, 2 = runtime error
## Change log    : see CHANGELOG.md alongside this script. Releases are
##               : immutable tags; consumers pin a tag + sha256.
#############################################################

set -euo pipefail

CONF="${GAMECTL_CONF:-/etc/gamectl.conf}"
[ -r "$CONF" ] || { echo "ERROR: config not found: $CONF" >&2; exit 2; }
# shellcheck source=/dev/null
source "$CONF"

TEMPLATE="${ARK_ROOT}/template"
INSTANCES_DIR="${ARK_ROOT}/instances"
BACKUP_DIR="${ARK_ROOT}/bak"
CLUSTER_DIR="${ARK_ROOT}/cluster"
UNIT="/etc/systemd/system/ark@.service"
VERSION="1.6.1"

## ---- small helpers ------------------------------------------------------
log()  { printf '[gamectl] %s\n' "$*"; }
err()  { printf '[gamectl] ERROR: %s\n' "$*" >&2; }
die()  { err "$*"; exit 2; }

## Resolve an instance's fields into globals: I_MAP I_GAME I_QUERY I_RCON
resolve() {
  local key="$1"
  [ -n "${INSTANCES[$key]+x}" ] || die "unknown instance '$key' (check $CONF)"
  # shellcheck disable=SC2206
  local parts=(${INSTANCES[$key]})
  I_MAP="${parts[0]}"; I_GAME="${parts[1]}"; I_QUERY="${parts[2]}"; I_RCON="${parts[3]}"
}

## Expand "all" to every instance key, or echo the single key back.
keys_for() {
  if [ "${1:-}" = "all" ] || [ -z "${1:-}" ]; then
    printf '%s\n' "${!INSTANCES[@]}"
  else
    printf '%s\n' "$1"
  fi
}


as_ark() { sudo -u "$ARK_USER" -H "$@"; }
## steamcmd is notoriously flaky on large downloads (CDN stalls, the
## "Missing configuration" first-run race, 0x402 aborts) but resumes cleanly
## from wherever it died. Retry before declaring real failure. Override the
## attempt count via STEAM_RETRIES in gamectl.conf or the environment.
STEAM_RETRIES="${STEAM_RETRIES:-4}"
steam_app_update() {
  local attempt=1 rc=0
  # Steam beta branch pin (e.g. preaquatica). The flag MUST be passed as
  # separate argv elements: +app_update 376030 -beta preaquatica validate.
  # Quoting it into one argument ("376030 -beta preaquatica") does NOT work:
  # steamcmd parses the leading app id, silently DISCARDS the rest, and
  # updates the live branch while reporting success.
  local -a app_args=("$ARK_APPID")
  if [ -n "${ARK_BRANCH:-}" ]; then
    app_args+=(-beta "$ARK_BRANCH")
  fi
  while :; do
    as_ark "$STEAMCMD" +force_install_dir "$TEMPLATE" +login anonymous \
      +app_update "${app_args[@]}" validate +quit && return 0
    rc=$?
    if [ "$attempt" -ge "$STEAM_RETRIES" ]; then
      err "steamcmd failed (rc=$rc) after ${STEAM_RETRIES} attempts"
      return "$rc"
    fi
    err "steamcmd failed (rc=$rc), attempt ${attempt}/${STEAM_RETRIES} -- retrying in 10s (resumes from last position)"
    attempt=$((attempt + 1))
    sleep 10
  done
}


## ---- launch command builder --------------------------------------------
## Writes instances/<key>/server-start.sh from config. Regenerated on
## create/sync so port/mod/cluster changes always take effect.
write_start_script() {
  local key="$1"; resolve "$key"
  local dir="${INSTANCES_DIR}/${key}"
  local bin="${dir}/ShooterGame/Binaries/Linux"
  local opts="${I_MAP}?listen"
  opts+="?SessionName=${key}"
  # Extra ?Key=Value options from gamectl.conf (e.g. rate multipliers).
  # Launch options override GameUserSettings.ini, so automation can manage
  # rates without fighting ARK's rewrite of that file on shutdown.
  [ -n "${ARK_EXTRA_QUERY:-}" ] && opts+="${ARK_EXTRA_QUERY}"
  opts+="?ServerAdminPassword=${ADMIN_PASSWORD}"
  opts+="?RCONEnabled=True?RCONPort=${I_RCON}"
  opts+="?Port=${I_GAME}?QueryPort=${I_QUERY}"

  # -automanagedmods is DISABLED by default: the engine's child-process wait
  # (FLinuxPlatformProcess::WaitForProc) hard-crashes with SEGV on modern
  # glibc (waitid EINVAL). Mods are pre-installed by 'gamectl mods' instead.
  local automods=""
  [ "${ARK_AUTOMANAGED_MODS:-false}" = "true" ] && automods=" -automanagedmods"
  cat > "${bin}/server-start.sh" <<SH
#!/bin/bash
# Generated by gamectl -- do not edit by hand; edit gamectl.conf and re-sync.
cd "${bin}"
exec ./ShooterGameServer "${opts}" \\
  -server -log${automods} \\
  -clusterid=${CLUSTER_ID} -ClusterDirOverride=${CLUSTER_DIR} \\
  -NoTransferFromFiltering
SH
  chmod 0755 "${bin}/server-start.sh"
  chown "${ARK_USER}:${ARK_USER}" "${bin}/server-start.sh"
}

## Write ActiveMods= into an instance's GameUserSettings.ini [ServerSettings].
apply_mods() {
  local key="$1"
  local cfg="${INSTANCES_DIR}/${key}/ShooterGame/Saved/Config/LinuxServer/GameUserSettings.ini"
  as_ark mkdir -p "$(dirname "$cfg")"
  as_ark touch "$cfg"
  # remove any existing ActiveMods line, then set the current one
  as_ark sed -i '/^ActiveMods=/d' "$cfg"
  if [ -n "${MODS}" ]; then
    if grep -q '^\[ServerSettings\]' "$cfg"; then
      as_ark sed -i "/^\[ServerSettings\]/a ActiveMods=${MODS}" "$cfg"
    else
      printf '[ServerSettings]\nActiveMods=%s\n' "${MODS}" | as_ark tee -a "$cfg" >/dev/null
    fi
  fi
}

## The known Linux -automanagedmods fix: make steamcmd + steamapps reachable
## from inside the server's ThirdParty SteamCMD path so the server can fetch
## and unpack workshop mods itself.
setup_mod_symlinks() {
  local key="$1"
  local scmd="${INSTANCES_DIR}/${key}/Engine/Binaries/ThirdParty/SteamCMD/Linux"
  as_ark mkdir -p "$scmd"
  as_ark ln -sfn "${STEAM_HOME}/.steam/steamcmd/steamcmd.sh" "${scmd}/steamcmd.sh" 2>/dev/null || true
  as_ark ln -sfn "${STEAM_HOME}/.steam/steamapps" "${scmd}/steamapps" 2>/dev/null || true
}

## ---- subcommands --------------------------------------------------------
cmd_install() {
  [ "$(id -u)" -eq 0 ] || die "install must run as root"
  id "$ARK_USER" &>/dev/null || { log "creating user $ARK_USER"; adduser --system --group --home "$STEAM_HOME" "$ARK_USER"; }
  command -v "$STEAMCMD" >/dev/null || die "steamcmd not found at $STEAMCMD (apt install steamcmd)"
  command -v mcrcon      >/dev/null || err "mcrcon not found -- 'rcon' subcommand will not work until installed"
  mkdir -p "$TEMPLATE" "$INSTANCES_DIR" "$BACKUP_DIR" "$CLUSTER_DIR"
  chown -R "${ARK_USER}:${ARK_USER}" "$ARK_ROOT"
  log "downloading ARK server (app ${ARK_APPID}) into template..."
  steam_app_update || die "ARK download failed after ${STEAM_RETRIES} steamcmd attempts"
  log "install complete. Next: 'gamectl create <instance>' for each map."
}

cmd_update() {
  [ "$(id -u)" -eq 0 ] || die "update must run as root"
  log "updating template (app ${ARK_APPID})..."
  steam_app_update || die "ARK download failed after ${STEAM_RETRIES} steamcmd attempts"
  log "template updated. Run 'gamectl sync all' to roll it out (instances must be stopped)."
}

cmd_create() {
  [ "$(id -u)" -eq 0 ] || die "create must run as root"
  local key="${1:?usage: gamectl create <instance>}"; resolve "$key"
  [ -d "$TEMPLATE/ShooterGame" ] || die "template missing -- run 'gamectl install' first"
  local dir="${INSTANCES_DIR}/${key}"
  log "creating instance '${key}' (${I_MAP}) from template..."
  as_ark mkdir -p "$dir"
  as_ark rsync -a --delete --exclude 'ShooterGame/Saved' "$TEMPLATE/" "$dir/"
  setup_mod_symlinks "$key"
  apply_mods "$key"
  write_start_script "$key"
  install_unit
  systemctl enable "ark@${key}" >/dev/null 2>&1 || true
  log "instance '${key}' ready. Start with: gamectl start ${key}"
}

cmd_sync() {
  [ "$(id -u)" -eq 0 ] || die "sync must run as root"
  local key skipped=0
  for key in $(keys_for "${1:-all}"); do
    resolve "$key"
    if systemctl is-active --quiet "ark@${key}"; then
      err "instance '${key}' is running -- stop it before sync; skipping"
      skipped=$((skipped + 1)); continue
    fi
    log "syncing template -> ${key} (saves preserved)..."
    as_ark rsync -a --delete --exclude 'ShooterGame/Saved' "$TEMPLATE/" "${INSTANCES_DIR}/${key}/"
    setup_mod_symlinks "$key"; apply_mods "$key"; write_start_script "$key"
  done
  ## Skipping is a FAILURE to roll out, not a success. Callers (Ansible
  ## handlers, the maintenance script) must be able to tell the difference:
  ## a silent no-op here means template changes never reached the instance.
  if [ "$skipped" -gt 0 ]; then
    err "sync skipped ${skipped} running instance(s) -- nothing rolled out to them"
    return 1
  fi
}

cmd_start() {
  local key; for key in $(keys_for "${1:-all}"); do resolve "$key"; log "starting ${key}..."; systemctl start "ark@${key}"; done
}

## Graceful stop: save the world over RCON, tell the server to exit, then
## stop the unit. Prevents the save corruption a hard kill can cause.
cmd_stop() {
  local key
  for key in $(keys_for "${1:-all}"); do
    resolve "$key"
    if systemctl is-active --quiet "ark@${key}"; then
      log "saving + stopping ${key}..."
      mcrcon -H 127.0.0.1 -P "$I_RCON" -p "$ADMIN_PASSWORD" "saveworld" >/dev/null 2>&1 || err "${key}: RCON saveworld failed (stopping anyway)"
      mcrcon -H 127.0.0.1 -P "$I_RCON" -p "$ADMIN_PASSWORD" "doexit"    >/dev/null 2>&1 || true
      sleep 5
    fi
    systemctl stop "ark@${key}" || true
  done
}

cmd_restart() { cmd_stop "${1:-all}"; cmd_start "${1:-all}"; }

## RESTARTS + SINCE matter: a crash-looping instance reports state "active"
## or "activating" between deaths, so state alone hides a flapping server.
## A climbing restart count with a SINCE of seconds ago == crash loop.
cmd_status() {
  printf '%-16s %-14s %-8s %-8s %-12s %-9s %s\n' \
    INSTANCE MAP GAME QUERY STATE RESTARTS SINCE
  local key
  for key in $(keys_for all); do
    resolve "$key"
    local state restarts since
    ## is-active PRINTS the state and exits nonzero for anything but active,
    ## so a '|| echo inactive' fallback appends a second word instead of
    ## replacing it. Take the output, and only substitute when it is empty.
    state=$(systemctl is-active "ark@${key}" 2>/dev/null) || true
    [ -n "$state" ] || state=unknown
    restarts=$(systemctl show -p NRestarts --value "ark@${key}" 2>/dev/null)
    since=$(systemctl show -p ActiveEnterTimestamp --value "ark@${key}" 2>/dev/null)
    printf '%-16s %-14s %-8s %-8s %-12s %-9s %s\n' \
      "$key" "$I_MAP" "$I_GAME" "$I_QUERY" "$state" "${restarts:-?}" "${since:-n/a}"
  done
}

cmd_rcon() {
  local key="${1:?usage: gamectl rcon <instance> <command...>}"; shift; resolve "$key"
  command -v mcrcon >/dev/null || die "mcrcon not installed"
  mcrcon -H 127.0.0.1 -P "$I_RCON" -p "$ADMIN_PASSWORD" "$*"
}

## Re-apply the mod list to all instances and (re)start so -automanagedmods
## pulls + unpacks them. Server-side download; no external mod tool needed.
## Download a workshop item with retries (steamcmd is as flaky for workshop
## downloads as it is for app updates; downloads resume between attempts).
steam_workshop_download() {
  local modid="$1" validate="${2:-}" attempt=1 rc=0
  while :; do
    as_ark "$STEAMCMD" +force_install_dir "$TEMPLATE" +login anonymous \
      +workshop_download_item 346110 "$modid" ${validate:+"$validate"} +quit && return 0
    rc=$?
    if [ "$attempt" -ge "$STEAM_RETRIES" ]; then
      err "workshop download ${modid} failed (rc=$rc) after ${STEAM_RETRIES} attempts"
      return "$rc"
    fi
    err "workshop download ${modid} failed (rc=$rc), attempt ${attempt}/${STEAM_RETRIES} -- retrying in 10s"
    attempt=$((attempt + 1)); sleep 10
  done
}

## Extract one downloaded mod into the template's Content/Mods: copy plain
## files, inflate UE .z chunk archives, and build the <id>.mod metadata file.
## The .z and .mod binary handling is ported verbatim from ark-server-tools
## (arkmanager), the long-standing reference implementation.
extract_mod() {
  local modid="$1"
  local src="${TEMPLATE}/steamapps/workshop/content/346110/${modid}"
  local dest="${TEMPLATE}/ShooterGame/Content/Mods/${modid}"
  ## ASE mod content is cooked for WINDOWS even when the server runs Linux:
  ## the dedicated server loads Windows-cooked packages. The LinuxNoEditor
  ## tree targets the long-abandoned Linux CLIENT; feeding it to the server
  ## yields packages it mis-parses -- "Bad name index N/120" in LinkerLoad,
  ## SEGV ~25s in, empty ShooterGame.log, identical for every mod.
  ## ark-server-tools hardcodes this (mod_branch defaults to Windows).
  ## Selection is by mod.info presence, matching arkmanager.
  local branch="${MOD_BRANCH:-Windows}"
  if   [ -f "${src}/${branch}NoEditor/mod.info" ]; then src="${src}/${branch}NoEditor"
  elif [ -f "${src}/WindowsNoEditor/mod.info" ];   then src="${src}/WindowsNoEditor"
  elif [ -f "${src}/LinuxNoEditor/mod.info" ];     then src="${src}/LinuxNoEditor"
  fi
  [ -f "${src}/mod.info" ] || { err "${modid}: no mod.info in download (broken/incomplete); skipping"; return 1; }
  log "mod ${modid}: source $(basename "$src")"

  rm -rf "$dest"; mkdir -p "$dest"
  rsync -a --exclude='*.z' --exclude='*.z.uncompressed_size' "${src}/" "${dest}/"

  ## Inflate one .z ATOMICALLY: temp file, size-verify against the
  ## .uncompressed_size sidecar when present (CRLF endings -- Windows
  ## tooling), one retry, then mv into place. A truncated .uasset SEGVs the
  ## server at load ("Bad name index"); fail the mod loudly instead of
  ## shipping a half-written file (1.5 did the latter).
  local f zfail=0
  while IFS= read -r -d '' f; do
    mkdir -p "${dest}/$(dirname "$f")"
    local zout="${dest}/${f%.z}" ztmp want have attempt ok=0
    ztmp="${dest}/${f%.z}.tmp.$$"
    want=""
    [ -f "${src}/${f}.uncompressed_size" ] && want="$(tr -d '\r\n' < "${src}/${f}.uncompressed_size")"
    for attempt in 1 2; do
      if \
    # shellcheck disable=SC2016  # perl code in single quotes on purpose
    perl -M'Compress::Raw::Zlib' -e '
      my $sig;
      read(STDIN, $sig, 8) or die "Unable to read compressed file: $!";
      if ($sig != "\xC1\x83\x2A\x9E\x00\x00\x00\x00"){ die "Bad file magic"; }
      my $data;
      read(STDIN, $data, 24) or die "Unable to read compressed file: $!";
      my ($chunksizelo, $chunksizehi, $comprtotlo, $comprtothi,
          $uncomtotlo, $uncomtothi) = unpack("(LLLLLL)<", $data);
      my @chunks = (); my $comprused = 0;
      while ($comprused < $comprtotlo) {
        read(STDIN, $data, 16) or die "Unable to read compressed file: $!";
        my ($comprsizelo, $comprsizehi,
            $uncomsizelo, $uncomsizehi) = unpack("(LLLL)<", $data);
        push @chunks, $comprsizelo; $comprused += $comprsizelo;
      }
      foreach my $comprsize (@chunks) {
        read(STDIN, $data, $comprsize) or die "File read failed: $!";
        my ($inflate, $status) = new Compress::Raw::Zlib::Inflate();
        my $output;
        $status = $inflate->inflate($data, $output, 1);
        if ($status != Z_STREAM_END) { die "Bad compressed stream; status: " . ($status); }
        if (length($data) != 0) { die "Unconsumed data in input" }
        print $output;
      }
    ' <"${src}/${f}" >"$ztmp" 2>/dev/null; then
        have="$(stat -c%s "$ztmp")"
        if [ -z "$want" ] || [ "$have" = "$want" ]; then ok=1; break; fi
        err "${modid}: ${f%.z}: size ${have} != expected ${want} (attempt ${attempt})"
      else
        err "${modid}: ${f%.z}: inflate FAILED (attempt ${attempt})"
      fi
      rm -f "$ztmp"
    done
    if [ "$ok" -eq 1 ]; then mv -f "$ztmp" "$zout"; else rm -f "$ztmp"; zfail=$((zfail+1)); fi
  done < <(find "$src" -type f -name '*.z' -printf '%P\0')
  if [ "$zfail" -gt 0 ]; then
    err "${modid}: ${zfail} file(s) failed extraction -- mod NOT installed"
    rm -rf "$dest"
    return 1
  fi

  # shellcheck disable=SC2016  # perl code in single quotes on purpose
  perl -e '
    my $data;
    { local $/; $data = <STDIN>; }
    my $mapnamelen = unpack("@0 L<", $data);
    my $mapname = substr($data, 4, $mapnamelen - 1);
    my $nummaps = unpack("@" . ($mapnamelen + 4) . " L<", $data);
    my $pos = $mapnamelen + 8;
    my $modname = ($ARGV[2] || $mapname) . "\x00";
    my $modnamelen = length($modname);
    my $modpath = "../../../" . $ARGV[0] . "/Content/Mods/" . $ARGV[1] . "\x00";
    my $modpathlen = length($modpath);
    print pack("L< L< L< Z$modnamelen L< Z$modpathlen L<",
      $ARGV[1], 0, $modnamelen, $modname, $modpathlen, $modpath, $nummaps);
    for (my $mapnum = 0; $mapnum < $nummaps; $mapnum++){
      my $mapfilelen = unpack("@" . ($pos) . " L<", $data);
      my $mapfile = substr($data, $mapnamelen + 12, $mapfilelen);
      print pack("L< Z$mapfilelen", $mapfilelen, $mapfile);
      $pos = $pos + 4 + $mapfilelen;
    }
    print "\x33\xFF\x22\xFF\x02\x00\x00\x00\x01";
  ' ShooterGame "$modid" "" <"${dest}/mod.info" >"${dest}.mod"

  if [ -f "${dest}/modmeta.info" ]; then
    cat "${dest}/modmeta.info" >>"${dest}.mod"
  else
    printf '\x01\x00\x00\x00\x08\x00\x00\x00ModType\x00\x02\x00\x00\x001\x00' >>"${dest}.mod"
  fi
  chown -R "${ARK_USER}:${ARK_USER}" "$dest" "${dest}.mod"
}

## Remove workshop mods present on disk but no longer declared in MODS.
## Workshop content is ALL-NUMERIC: directories <id>/ plus metadata <id>.mod.
## Everything else in this directory is stock and must never be touched:
## 111111111 (ships with the server) and the official map DLC, which lives
## here under non-numeric names (Ragnarok, FjordurOfficial, CrystalIsles,
## LostIsland, TheCenter, Valguero).
prune_mods() {
  local dir="$1" id keep wanted pruned=0 ids
  ## This function runs rm -rf on a computed path, so refuse anything that is
  ## not a Content/Mods directory. Cheap interlock, catastrophic without it.
  case "$dir" in
    */ShooterGame/Content/Mods) : ;;
    *) err "prune_mods: refusing to operate on unexpected path '${dir}'"; return 1 ;;
  esac
  [ -d "$dir" ] || return 0
  ids=$( { find "$dir" -maxdepth 1 -mindepth 1 -type d -printf '%f\n'
           find "$dir" -maxdepth 1 -type f -name '*.mod' -printf '%f\n' | sed 's/\.mod$//'
         } | grep -E '^[0-9]+$' | grep -vx '111111111' | sort -u )
  for id in $ids; do
    keep=0
    for wanted in ${MODS//,/ }; do
      [ "$id" = "$wanted" ] && { keep=1; break; }
    done
    [ "$keep" -eq 1 ] && continue
    log "pruning undeclared mod ${id} from ${dir##*/instances/}"
    rm -rf "${dir:?}/${id}" "${dir:?}/${id}.mod"
    pruned=$((pruned + 1))
  done
  [ "$pruned" -eq 0 ] || log "pruned ${pruned} undeclared mod(s)"
  return 0
}

cmd_mods() {
  [ "$(id -u)" -eq 0 ] || die "mods must run as root"
  # Exactly one mods run at a time: an orphaned concurrent run (async job
  # surviving a Ctrl-C) otherwise deletes this run's temp files mid-extract.
  exec 9>"${ARK_ROOT}/.gamectl-mods.lock"
  flock -n 9 || die "another 'gamectl mods' is already running (lock: ${ARK_ROOT}/.gamectl-mods.lock)"
  local force="${1:-}"
  local modid installed=0 skipped=0 failed=0
  ## An empty MODS list is a valid declaration (vanilla), NOT a no-op: fall
  ## through to the apply loop below so ActiveMods is CLEARED. 1.5.2 returned
  ## early here, so removing mods from gamectl.conf silently left the old
  ## list in GameUserSettings.ini and instances kept loading them.
  ## (The for loop below iterates zero times on an empty list.)
  [ -n "${MODS}" ] || log "MODS is empty -- clearing ActiveMods on all instances"
  for modid in ${MODS//,/ }; do
    if [ -f "${TEMPLATE}/ShooterGame/Content/Mods/${modid}.mod" ] && [ "$force" != "force" ]; then
      skipped=$((skipped + 1)); continue
    fi
    log "mod ${modid}: downloading..."
    local v=""; [ "$force" = "force" ] && v="validate"
    if ! steam_workshop_download "$modid" "$v"; then failed=$((failed + 1)); continue; fi
    log "mod ${modid}: extracting..."
    if extract_mod "$modid"; then
      log "mod ${modid}: installed"
      installed=$((installed + 1))
    else
      failed=$((failed + 1))
    fi
  done
  ## apply_mods here is best-effort: ARK rewrites GameUserSettings.ini when it
  ## shuts down, so ActiveMods written under a RUNNING instance gets clobbered.
  ## The authoritative application is 'gamectl sync' with instances stopped.
  ## Declared state is truth. The template is pruned unconditionally; sync's
  ## rsync --delete then propagates the removal to instances. Running
  ## instances are left alone (deleting content under a live server is how you
  ## crash one) -- the sync that follows a stop handles them.
  prune_mods "${TEMPLATE}/ShooterGame/Content/Mods" || true
  local key running=0
  for key in $(keys_for all); do
    resolve "$key"; apply_mods "$key"
    if systemctl is-active --quiet "ark@${key}"; then
      running=$((running + 1))
    else
      prune_mods "${INSTANCES_DIR}/${key}/ShooterGame/Content/Mods" || true
    fi
  done
  log "mods: ${installed} installed, ${skipped} up to date, ${failed} failed"
  if [ "$running" -gt 0 ]; then
    log "note: ${running} instance(s) running -- stop them and 'gamectl sync all' to apply"
  fi
  [ "$installed" -gt 0 ] && log "run 'gamectl sync all' (stopped instances) then restart to apply"
  [ "$failed" -eq 0 ] || return 1
}

cmd_backup() {
  [ "$(id -u)" -eq 0 ] || die "backup must run as root"
  local key ts; ts="$(date +%Y%m%d-%H%M%S)"
  as_ark mkdir -p "$BACKUP_DIR"
  for key in $(keys_for "${1:-all}"); do
    resolve "$key"
    local saved="${INSTANCES_DIR}/${key}/ShooterGame/Saved"
    [ -d "$saved" ] || { err "${key}: no Saved dir yet; skipping"; continue; }
    local was_up=0
    systemctl is-active --quiet "ark@${key}" && { was_up=1; cmd_stop "$key"; }
    log "archiving ${key}..."
    as_ark tar -czf "${BACKUP_DIR}/${key}-${ts}.tar.gz" -C "$saved" .
    [ "$was_up" -eq 1 ] && cmd_start "$key"
  done
  log "purging backups older than ${BACKUP_KEEP_DAYS} days..."
  find "$BACKUP_DIR" -name '*.tar.gz' -mtime "+${BACKUP_KEEP_DAYS}" -delete 2>/dev/null || true
}

cmd_restore() {
  [ "$(id -u)" -eq 0 ] || die "restore must run as root"
  local key="${1:?usage: gamectl restore <instance> [archive]}"; resolve "$key"
  local archive="${2:-}"
  [ -n "$archive" ] || archive="$(ls -1t "${BACKUP_DIR}/${key}-"*.tar.gz 2>/dev/null | head -1 || true)"
  [ -n "$archive" ] && [ -f "$archive" ] || die "no backup archive found for '${key}'"
  systemctl is-active --quiet "ark@${key}" && cmd_stop "$key"
  local saved="${INSTANCES_DIR}/${key}/ShooterGame/Saved"
  log "restoring ${key} from $(basename "$archive")..."
  as_ark mkdir -p "$saved"
  as_ark tar -xzf "$archive" -C "$saved"
  log "restored. Start with: gamectl start ${key}"
}

install_unit() {
  cat > "$UNIT" <<UNIT
[Unit]
Description=ARK: Survival Evolved dedicated server (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=${ARK_USER}
Group=${ARK_USER}
WorkingDirectory=${INSTANCES_DIR}/%i/ShooterGame/Binaries/Linux
ExecStart=${INSTANCES_DIR}/%i/ShooterGame/Binaries/Linux/server-start.sh
LimitNOFILE=100000
Restart=on-failure
RestartSec=20

[Install]
WantedBy=multi-user.target
UNIT
  systemctl daemon-reload
}

usage() {
  cat <<USAGE
gamectl -- ARK: Survival Evolved server management

  gamectl install                 First-time setup + download server to template
  gamectl update                  Update the template from Steam
  gamectl create <instance>       Provision an instance from the template
  gamectl sync   [instance|all]   Roll template updates into stopped instance(s)
  gamectl start  [instance|all]   Start instance(s)
  gamectl stop   [instance|all]   Save + gracefully stop instance(s)
  gamectl restart[instance|all]   Stop then start
  gamectl status                  Show all instances and their state
  gamectl rcon   <instance> <cmd> Send an RCON command (via mcrcon)
  gamectl mods [force]            Download + install Workshop mods into the
                                  template ('force' reinstalls); sync applies
  gamectl backup [instance|all]   Save-safe archive of instance save data
  gamectl restore <instance> [archive]  Restore newest (or given) backup
  gamectl version                 Print the toolkit version

Instances and settings live in ${CONF}.
USAGE
}

## ---- dispatch -----------------------------------------------------------
cmd="${1:-}"; shift || true
case "$cmd" in
  install) cmd_install "$@" ;;
  update)  cmd_update  "$@" ;;
  create)  cmd_create  "$@" ;;
  sync)    cmd_sync    "$@" ;;
  start)   cmd_start   "$@" ;;
  stop)    cmd_stop    "$@" ;;
  restart) cmd_restart "$@" ;;
  status)  cmd_status  "$@" ;;
  rcon)    cmd_rcon    "$@" ;;
  mods)    cmd_mods    "$@" ;;
  backup)  cmd_backup  "$@" ;;
  restore) cmd_restore "$@" ;;
  version) echo "gamectl ${VERSION}" ;;
  ""|-h|--help|help) usage ;;
  *) err "unknown command '$cmd'"; usage; exit 1 ;;
esac